# Integration-test environment. `pnpm test:db:up` generates a real .env.test
# from the running local Supabase stack; these are the standard local defaults
# and are safe to commit (they are NOT production secrets).
#
# Copy to .env.test only if you are wiring the DB up manually.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=<from `supabase status`>
SUPABASE_SERVICE_ROLE_KEY=<from `supabase status`>
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
