NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Comma-separated emails that are always treated as admin and can never be
# locked out. These accounts are auto-promoted to admin on sign-in.
SUPER_ADMIN_EMAILS=you@example.com
# 4-digit PIN that unlocks the hidden /sm-control panel, where you set when the
# customer's dashboard subscription ends (or lock it immediately). Not linked
# anywhere in the UI — reach it by typing the /sm-control path directly. Leave
# blank to disable the panel.
SUPER_MANAGER_PIN=0000

# Public base URL of the app, used to display the NCM webhook URL on the
# NCM settings page. Falls back to NEXT_PUBLIC_SITE_URL, then localhost.
# The NCM API token, environment, and webhook secret are stored in the
# ncm_settings table (managed in the admin Settings page), not here.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# eSewa payment gateway for storefront online checkout. The values below are
# eSewa's public sandbox/test credentials; swap in your live merchant code +
# secret and the production gateway URL for real payments.
ESEWA_MERCHANT_CODE=EPAYTEST
ESEWA_SECRET_KEY=8gBm/:&EnhH.1/q
ESEWA_GATEWAY_URL=https://rc-epay.esewa.com.np/api/epay/main/v2/form
# Public base URL used to build eSewa success/failure callback URLs.
# Falls back to NEXT_PUBLIC_APP_URL, then localhost.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Fonepay dynamic-QR for point-of-sale online payments. The values below are
# Fonepay's public UAT/sandbox credentials; swap in your live merchant code,
# secret, username, password, and the production API hosts for real payments.
#   Live QR download: https://merchantapi.fonepay.com/api/merchant/merchantDetailsForThirdParty/thirdPartyDynamicQrDownload
#   Live status check: https://merchantapi.fonepay.com/api/merchant/merchantDetailsForThirdParty/thirdPartyDynamicQrGetStatus
FONEPAY_MERCHANT_CODE=fonepay123
FONEPAY_SECRET_KEY=fonepay
FONEPAY_USERNAME=bijayk
FONEPAY_PASSWORD=password
FONEPAY_QR_DOWNLOAD_URL=https://uat-new-merchant-api.fonepay.com/api/merchant/merchantDetailsForThirdParty/thirdPartyDynamicQrDownload
FONEPAY_QR_STATUS_URL=https://uat-new-merchant-api.fonepay.com/api/merchant/merchantDetailsForThirdParty/thirdPartyDynamicQrGetStatus
# DEV ONLY. The public sandbox QR cannot be paid by real apps ("terminal not
# found"), so set this to true to make the status poll auto-report success and
# exercise the full pending -> paid flow locally. Ignored when NODE_ENV=production.
# Remove or leave unset for real (production-credential) testing.
FONEPAY_SIMULATE=true
